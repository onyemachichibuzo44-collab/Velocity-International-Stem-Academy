<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8"><meta name="viewport" content="width=device-width,initial-scale=1.0">
<title>VELOCITY INTERNATIONAL STEM ACADEMY | Premium International Online STEM School</title>
<link href="https://fonts.googleapis.com/css2?family=Outfit:wght@300;400;500;600;700;800;900&family=Plus+Jakarta+Sans:wght@400;500;600;700&display=swap" rel="stylesheet">
<link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">
<style>
:root{--navy:#081a33;--navy2:#0e2a54;--navy3:#102e5a;--gold:#ffcc33;--gold2:#ffdb66;--blue:#3a7bff;--white:#ffffff;--soft:#e8eef8;--text:#b9c7dd}
*{margin:0;padding:0;box-sizing:border-box}
body{font-family:'Plus Jakarta Sans',sans-serif;background:#060f23;color:#fff;overflow-x:hidden;line-height:1.6}
h1,h2,h3,h4{font-family:'Outfit',sans-serif}
a{text-decoration:none;color:inherit}

/* TOP BAR */
.topbar{background:#081a33;color:#a8bdd8;text-align:center;padding:7px;font-size:11px;letter-spacing:.3px;border-bottom:1px solid #112a52}
.topbar b{color:#ffcc33}

/* HEADER */
header{background:rgba(8,26,51,.92);backdrop-filter:blur(20px);position:sticky;top:0;z-index:100;display:flex;justify-content:space-between;align-items:center;padding:14px 5%;border-bottom:1px solid rgba(255,204,51,.15)}
.brand{display:flex;align-items:center;gap:12px}
.v-logo{width:48px;height:48px;background:linear-gradient(135deg,#ffdf6b,#ffcc33);border-radius:50%;display:flex;align-items:center;justify-content:center;color:#081a33;font-weight:900;font-size:22px;box-shadow:0 4px 15px rgba(255,204,51,.3)}
.brand h2{font-size:18px;font-weight:800;letter-spacing:.5px;line-height:1}.brand h2 span{display:block;font-size:9px;font-weight:500;letter-spacing:2.2px;color:#9ab0cc;margin-top:2px}
.nav{display:flex;gap:28px;font-size:11px;font-weight:600;letter-spacing:.8px;align-items:center}.nav a{opacity:.8;transition:.3s;position:relative}.nav a:hover,.nav a.active{opacity:1;color:#ffcc33}.nav a.active:after{content:'';position:absolute;left:0;bottom:-6px;width:100%;height:2px;background:#ffcc33}
.btn-gold{background:linear-gradient(180deg,#ffe27a,#ffcc33);color:#081a33;padding:12px 22px;border-radius:100px;font-weight:800;font-size:12px;letter-spacing:.5px;box-shadow:0 6px 20px rgba(255,204,51,.35);transition:.3s}.btn-gold:hover{transform:translateY(-2px);box-shadow:0 10px 28px rgba(255,204,51,.45)}

/* HERO */
.hero{background:radial-gradient(800px 500px at 20% 0%, #143a7a 0%, transparent 60%), radial-gradient(900px 600px at 90% 20%, #0f2f66 0%, transparent 60%), #081a33;padding:80px 5% 60px;display:grid;grid-template-columns:1.15fr .85fr;gap:40px;align-items:center;position:relative;overflow:hidden}
.hero:before{content:'';position:absolute;inset:0;background:url('https://grainy-gradients.vercel.app/noise.svg');opacity:.03}
.eyebrow{color:#ffcc33;font-size:11px;font-weight:700;letter-spacing:3px;text-transform:uppercase;margin-bottom:16px;display:flex;align-items:center;gap:8px}
.eyebrow:before{content:'';width:30px;height:2px;background:#ffcc33;display:inline-block}
.hero h1{font-size:62px;line-height:.9;font-weight:900;letter-spacing:-1px}.hero h1 .gold{color:#ffcc33;background:linear-gradient(180deg,#ffe27a,#ffcc33);-webkit-background-clip:text;-webkit-text-fill-color:transparent;display:inline-block}
.hero .sub{font-size:19px;color:#d6e2f3;margin:18px 0 10px;font-weight:400;font-style:italic;opacity:.9;line-height:1.4}
.hero-desc{color:var(--text);font-size:14px;margin:22px 0;display:flex;flex-direction:column;gap:12px}
.hero-desc b{color:#fff}.hero-desc .row{display:flex;gap:12px;align-items:flex-start}
.hero-desc .icon{width:32px;height:32px;min-width:32px;background:rgba(255,204,51,.12);border:1px solid rgba(255,204,51,.2);border-radius:8px;display:flex;align-items:center;justify-content:center;color:#ffcc33;font-size:13px}
.hero-cta{display:flex;gap:12px;margin-top:28px;flex-wrap:wrap}
.btn-white{background:#fff;color:#081a33;padding:13px 22px;border-radius:100px;font-weight:700;font-size:13px;display:flex;align-items:center;gap:8px}.btn-outline{border:1px solid rgba(255,255,255,.2);color:#fff;padding:13px 22px;border-radius:100px;font-weight:600;font-size:13px;display:flex;align-items:center;gap:8px;background:rgba(255,255,255,.06);backdrop-filter:blur(10px)}

/* HERO CARD */
.hero-visual{position:relative;height:520px}
.glass-card{position:absolute;border-radius:20px;overflow:hidden;box-shadow:0 20px 60px rgba(0,0,0,.4);border:1px solid rgba(255,255,255,.1)}
.gc-main{left:0;top:0;width:72%;height:100%;background:#0f2a54}
.gc-main img{width:100%;height:100%;object-fit:cover}
.gc-top{right:0;top:10px;width:38%;height:42%;background:#fff;padding:0;z-index:2;transform:rotate(2deg)}.gc-top img{width:100%;height:100%;object-fit:cover}
.gc-bottom{right:6%;bottom:20px;width:34%;height:32%;z-index:3;transform:rotate(-2deg);background:#0f2a54}
.gc-bottom img{width:100%;height:100%;object-fit:cover}
.float-badge{position:absolute;left:-10px;bottom:40px;background:#fff;color:#081a33;padding:12px 16px;border-radius:12px;box-shadow:0 12px 30px rgba(0,0,0,.25);z-index:4;display:flex;gap:10px;align-items:center}
.float-badge .fb-icon{width:40px;height:40px;background:#ffcc33;border-radius:10px;display:flex;align-items:center;justify-content:center;font-size:18px}
.float-badge b{font-size:13px;display:block;line-height:1}.float-badge span{font-size:10px;color:#6b7a90}

/* STATS */
.stats{background:#081a33;border-top:1px solid rgba(255,255,255,.06);border-bottom:1px solid rgba(255,255,255,.06);display:grid;grid-template-columns:repeat(4,1fr);padding:22px 5%;gap:20px}
.stat{display:flex;gap:12px;align-items:center}.stat .s-icon{width:44px;height:44px;background:rgba(255,204,51,.1);border:1px solid rgba(255,204,51,.18);border-radius:12px;display:flex;align-items:center;justify-content:center;color:#ffcc33}.stat b{font-size:20px;display:block;line-height:1}.stat span{font-size:11px;color:#9ab0cc}

/* SECTIONS */
.section{padding:80px 5%}.section-dark{background:#071427}.section-light{background:#f6f8fc;color:#081a33}
.eyebrow-center{text-align:center;justify-content:center;margin-bottom:10px}
.title{font-size:42px;font-weight:800;text-align:center;letter-spacing:-.5px;line-height:1.1;margin-bottom:12px}.title .gold{color:#ffcc33}
.title-light{color:#081a33}.subtitle{color:#8a9bb5;text-align:center;max-width:600px;margin:0 auto 40px;font-size:14px}

/* HOW TO JOIN + CLASSROOMS */
.two-grid{display:grid;grid-template-columns:.9fr 1.1fr;gap:20px;margin-top:20px}
.card-premium{background:linear-gradient(180deg,rgba(255,255,255,.06),rgba(255,255,255,.02));border:1px solid rgba(255,255,255,.1);border-radius:20px;padding:24px;backdrop-filter:blur(20px)}
.card-premium h3{color:#ffcc33;font-size:14px;margin-bottom:18px;display:flex;align-items:center;gap:10px;letter-spacing:.5px}
.card-premium h3 i{width:32px;height:32px;background:rgba(255,204,51,.15);border-radius:8px;display:flex;align-items:center;justify-content:center}
.steps{display:flex;flex-direction:column;gap:14px}
.step{display:flex;gap:12px;align-items:center;background:rgba(255,255,255,.04);border:1px solid rgba(255,255,255,.06);padding:12px;border-radius:12px}
.step-num{width:28px;height:28px;min-width:28px;background:#ffcc33;color:#081a33;border-radius:50%;display:flex;align-items:center;justify-content:center;font-weight:800;font-size:12px}
.btn-blue-mod{background:#2a64f6;color:#fff;padding:8px 16px;border-radius:100px;font-weight:700;font-size:11px}
.class-grid-mod{display:grid;grid-template-columns:1fr 1fr;gap:10px}
.class-item{background:rgba(255,255,255,.05);border:1px solid rgba(255,255,255,.08);border-radius:12px;padding:10px;display:flex;gap:10px;align-items:center;transition:.3s}.class-item:hover{border-color:rgba(255,204,51,.4);transform:translateY(-2px);background:rgba(255,255,255,.07)}
.class-item img{width:36px;height:26px;border-radius:5px;object-fit:cover}.class-item b{font-size:11px}.class-item span{font-size:10px;opacity:.7}

/* SUBJECTS */
.subject-grid{display:grid;grid-template-columns:repeat(5,1fr);gap:16px;margin-top:10px}
.sub-card{background:#fff;border-radius:18px;overflow:hidden;box-shadow:0 10px 30px rgba(8,26,51,.06);border:1px solid #e8ecf2;transition:.4s}.sub-card:hover{transform:translateY(-6px);box-shadow:0 20px 40px rgba(8,26,51,.12)}
.sub-card img{width:100%;height:120px;object-fit:cover}.sub-card .sc-body{padding:14px}.sub-card h5{font-size:12px;font-weight:800;margin-bottom:6px}.sub-card p{font-size:11px;color:#6b7a90;line-height:1.4}
.sub-tag{background:#fff7d6;color:#7a5d00;padding:4px 10px;border-radius:100px;font-size:9px;font-weight:700;display:inline-block;margin-top:8px}

/* WHY */
.why-grid{display:grid;grid-template-columns:1.1fr .9fr;gap:30px;align-items:center;margin-top:20px}
.why-list{display:grid;grid-template-columns:1fr 1fr;gap:12px}
.why-item{background:rgba(255,255,255,.05);border:1px solid rgba(255,255,255,.08);border-radius:14px;padding:14px;display:flex;gap:10px}
.why-item i{color:#ffcc33;font-size:14px;margin-top:2px}.why-item b{font-size:12px;display:block}.why-item span{font-size:11px;color:#9ab0cc;line-height:1.3}

/* LEARNING */
.learning-grid{display:grid;grid-template-columns:repeat(6,1fr);gap:12px;margin-top:30px}
.learn-card{background:rgba(255,255,255,.05);border:1px solid rgba(255,255,255,.1);border-radius:16px;padding:20px 14px;text-align:center;transition:.3s;backdrop-filter:blur(10px)}.learn-card:hover{background:rgba(255,204,51,.1);border-color:rgba(255,204,51,.3);transform:translateY(-4px)}
.learn-card i{font-size:22px;color:#ffcc33;margin-bottom:10px;display:block}.learn-card b{font-size:11px;display:block;letter-spacing:.3px}.learn-card span{font-size:10px;color:#9ab0cc}

/* CONTACT */
.contact-cta{background:linear-gradient(135deg,#0e2a54 0%,#081a33 100%);border:1px solid rgba(255,204,51,.15);border-radius:24px;padding:40px;display:grid;grid-template-columns:1.2fr .8fr;gap:30px;align-items:center;margin-top:30px;position:relative;overflow:hidden}
.contact-cta:before{content:'';position:absolute;width:400px;height:400px;background:radial-gradient(circle,rgba(255,204,51,.15),transparent 70%);right:-100px;top:-100px}
.contact-cta h2{font-size:32px;line-height:1.1}.contact-cta h2 span{color:#ffcc33}
.contact-infos{display:flex;flex-direction:column;gap:10px;margin:20px 0}
.contact-infos div{display:flex;gap:10px;align-items:center;font-size:13px;color:#c2d4f0}
.contact-infos i{width:32px;height:32px;background:rgba(255,204,51,.12);border-radius:8px;display:flex;align-items:center;justify-content:center;color:#ffcc33}
.gold-cta-grid{display:flex;flex-direction:column;gap:10px}
.g-cta{background:linear-gradient(180deg,#ffe27a,#ffcc33);color:#081a33;border-radius:14px;padding:14px 18px;display:flex;justify-content:space-between;align-items:center;transition:.3s;box-shadow:0 8px 20px rgba(0,0,0,.2)}.g-cta:hover{transform:translateY(-2px)}.g-cta b{font-size:13px;display:block}.g-cta small{font-size:9px;opacity:.7;display:block;word-break:break-all}.g-cta i{font-size:18px}

footer{text-align:center;padding:20px;color:#6b7a90;font-size:10px;border-top:1px solid rgba(255,255,255,.06)}

@media(max-width:980px){
.hero{grid-template-columns:1fr;padding:40px 5%}.hero h1{font-size:44px}.hero-visual{height:380px}.stats{grid-template-columns:1fr 1fr}.two-grid,.why-grid,.contact-cta{grid-template-columns:1fr}.subject-grid{grid-template-columns:1fr 1fr}.learning-grid{grid-template-columns:repeat(3,1fr)}.nav{display:none}
}
</style>
</head>
<body>

